executable = run_training.sh

arguments = \
  --training-id 30 \
  --data-dir data_3 \
  --max-files 1000 \
  --device cpu
# normalement max files est 400

output = logs/out.$(CLUSTER).$(PROCESS)
error  = logs/err.$(CLUSTER).$(PROCESS)
log    = logs/log.$(CLUSTER).$(PROCESS)

request_cpus   = 32 
# 32
request_memory = 96000 
# 64000

+MaxRuntime = 21600   

queue
